rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPERS ─────────────────────────────────────────────────────────────
    function usuarioAutenticado() { return request.auth != null; }
    function miPerfil() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function docDeMiGestoria() {
      return resource.data.gestoriaId == miPerfil().gestoriaId;
    }
    function nuevaDocDeMiGestoria() {
      return request.resource.data.gestoriaId == miPerfil().gestoriaId;
    }
    function esSuperAdmin() {
      return usuarioAutenticado() && miPerfil().rol == 'superadmin';
    }
    function isStaff() {
  return usuarioAutenticado() &&
    miPerfil().gestoriaId != null &&
    miPerfil().rol in [
      'propietario','admin_gral','admin','gestor',
      'operador','vendedor','asesor_comercial','asistente_multas'
    ];
}
    function isAdmin() {
      return usuarioAutenticado() &&
        miPerfil().rol in ['propietario','admin_gral','admin'];
    }
    function isPropietario() {
      return usuarioAutenticado() && miPerfil().rol == 'propietario';
    }
    function puedeCambiarEstado() {
  return usuarioAutenticado() &&
    miPerfil().rol in [
      'propietario','admin_gral','admin','gestor',
      'operador','asesor_comercial','superadmin','asistente_multas'
    ];
}

    // ─── USERS ───────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read:   if usuarioAutenticado() && request.auth.uid == uid;
      allow read:   if isStaff() && resource.data.gestoriaId == miPerfil().gestoriaId;
      allow read:   if esSuperAdmin();
      allow create, update: if esSuperAdmin();
      allow update: if usuarioAutenticado() && request.auth.uid == uid
                    && request.resource.data.rol == resource.data.rol
                    && request.resource.data.gestoriaId == resource.data.gestoriaId
                    && request.resource.data.activo == resource.data.activo;
    }

    // ─── GESTORÍAS ────────────────────────────────────────────────────────────
    match /gestionarias/{gestoriaId} {
      allow read:   if isStaff() && miPerfil().gestoriaId == gestoriaId;
      allow read:   if esSuperAdmin();
      allow write:  if isPropietario() && miPerfil().gestoriaId == gestoriaId;
      allow write:  if esSuperAdmin();
    }

    // ─── CONFIGURACIÓN ────────────────────────────────────────────────────────
    match /configuracion/{docId} {
      allow read:  if isStaff() && miPerfil().gestoriaId == docId;
      allow read:  if esSuperAdmin();
      allow write: if isPropietario() && miPerfil().gestoriaId == docId;
      allow write: if esSuperAdmin();
    }

    // ─── CLIENTES ─────────────────────────────────────────────────────────────
    match /clientes/{clienteId} {
      allow read:   if isStaff() && docDeMiGestoria();
      allow create: if isStaff() && nuevaDocDeMiGestoria();
      allow update: if isStaff() && docDeMiGestoria();
      allow delete: if isPropietario() && docDeMiGestoria();

      match /seguimientos/{segId} {
        allow read, write: if isStaff()
          && get(/databases/$(database)/documents/clientes/$(clienteId)).data.gestoriaId == miPerfil().gestoriaId;
      }
    }

    // ─── VEHÍCULOS ────────────────────────────────────────────────────────────
    match /vehiculos/{vehiculoId} {
      allow read:   if isStaff() && docDeMiGestoria();
      allow create: if isStaff() && nuevaDocDeMiGestoria();
      allow update: if isStaff() && docDeMiGestoria();
      allow delete: if isPropietario() && docDeMiGestoria();
    }

    // ─── TRÁMITES ─────────────────────────────────────────────────────────────
    match /tramites/{tramiteId} {
      allow read:   if isStaff() && docDeMiGestoria();
      allow read:   if esSuperAdmin();
      allow create: if isStaff() && nuevaDocDeMiGestoria();
      allow update: if puedeCambiarEstado() && docDeMiGestoria();
      allow delete: if isPropietario() && docDeMiGestoria();
    }

    match /inscripcionWorkflow/{wfId} {
      allow read:   if isStaff() && docDeMiGestoria();
      allow create: if isStaff() && nuevaDocDeMiGestoria();
      allow update: if isStaff() && docDeMiGestoria();
    }

    match /multaWorkflow/{wfId} {
      allow read:   if isStaff() && docDeMiGestoria();
      allow create: if isStaff() && nuevaDocDeMiGestoria();
      allow update: if isStaff() && docDeMiGestoria();
    }

    match /transferenciaWorkflow/{wfId} {
      allow read:   if isStaff() && docDeMiGestoria();
      allow create: if isStaff() && nuevaDocDeMiGestoria();
      allow update: if isStaff() && docDeMiGestoria();
    }

    // ─── TURNOS ───────────────────────────────────────────────────────────────
    match /turnos/{turnoId} {
      allow read:   if isStaff() && docDeMiGestoria();
      allow create: if isStaff() && nuevaDocDeMiGestoria();
      allow update: if isStaff() && docDeMiGestoria();
      allow delete: if isAdmin() && docDeMiGestoria();
    }

    // ─── NOTIFICACIONES ───────────────────────────────────────────────────────
    match /notificaciones/{notifId} {
      allow read:   if isStaff() && docDeMiGestoria();
      allow read:   if usuarioAutenticado() && resource.data.destinatarioId == request.auth.uid;
      allow create: if isStaff() && nuevaDocDeMiGestoria();
      allow update: if usuarioAutenticado() && resource.data.destinatarioId == request.auth.uid
                    && docDeMiGestoria();
    }

    // ─── TAREAS ───────────────────────────────────────────────────────────────
    match /tareas/{tareaId} {
      allow read:   if isStaff() && docDeMiGestoria();
      allow create: if isStaff() && nuevaDocDeMiGestoria();
      allow update: if isStaff() && docDeMiGestoria();
      allow delete: if isAdmin() && docDeMiGestoria();
    }

    // ─── NOTAS INTERNAS ───────────────────────────────────────────────────────
    match /notas_internas/{notaId} {
      allow read:   if isStaff() && docDeMiGestoria();
      allow create: if isStaff() && nuevaDocDeMiGestoria();
      allow update: if isStaff() && docDeMiGestoria();
      allow delete: if isAdmin() && docDeMiGestoria();
    }

    // ─── ALERTAS DEL SISTEMA ─────────────────────────────────────────────────
    match /alertas_sistema/{alertaId} {
      allow read:   if isStaff() && docDeMiGestoria();
      allow create: if isStaff() && nuevaDocDeMiGestoria();
      allow update: if isStaff() && docDeMiGestoria();
      allow delete: if isAdmin() && docDeMiGestoria();
    }

    // ─── PROSPECTOS ────────────────────────────────────────────────────────────
    match /prospectos/{prospectoId} {
      allow read:   if isStaff() && docDeMiGestoria();
      allow create: if isStaff() && nuevaDocDeMiGestoria();
      allow update: if isStaff() && docDeMiGestoria();
      allow delete: if isAdmin() && docDeMiGestoria();
    }

    // ─── CONSULTAS DE INFRACCIONES (cola que consume la extensión) ──────────
    match /consultasInfracciones/{consultaId} {
      allow read:   if isStaff() && docDeMiGestoria();
      allow create: if isStaff() && nuevaDocDeMiGestoria();
      allow update: if isStaff() && docDeMiGestoria();
    }
    // ─── AUDIT LOG ────────────────────────────────────────────────────────────
    match /audit_log/{logId} {
      allow read:   if (isAdmin() || esSuperAdmin()) && docDeMiGestoria();
      allow create: if isStaff() && nuevaDocDeMiGestoria();
    }

    // ─── VENCIMIENTOS ────────────────────────────────────────────────────────
    match /vencimientos/{vencId} {
      allow read:   if isStaff() && docDeMiGestoria();
      allow create: if isStaff() && nuevaDocDeMiGestoria();
      allow update: if isStaff() && docDeMiGestoria();
      allow delete: if isAdmin() && docDeMiGestoria();
    }

    // ─── CONVERSACIONES WA ────────────────────────────────────────────────────
    match /conversacionesWA/{convId} {
      allow read:   if isStaff() && docDeMiGestoria();
      allow create: if isStaff() && nuevaDocDeMiGestoria();
      allow update: if isStaff() && docDeMiGestoria();

      match /mensajes/{msgId} {
        allow read:   if isStaff() && get(/databases/$(database)/documents/conversacionesWA/$(convId)).data.gestoriaId == miPerfil().gestoriaId;
        allow create: if isStaff() && get(/databases/$(database)/documents/conversacionesWA/$(convId)).data.gestoriaId == miPerfil().gestoriaId;
      }
    }

    // ─── CAMPAÑAS ─────────────────────────────────────────────────────────────
    match /gestoriaData/{gestoriaId}/campanas/{campanaId} {
      allow read, write: if (isAdmin() || esSuperAdmin()) && miPerfil().gestoriaId == gestoriaId;

      match /envios/{envioId} {
        allow read, write: if (isAdmin() || esSuperAdmin()) && miPerfil().gestoriaId == gestoriaId;
      }
    }

    // ─── RECIBOS ──────────────────────────────────────────────────────────────
    match /recibos/{reciboId} {
      allow read:   if isStaff() && docDeMiGestoria();
      allow create: if isStaff() && nuevaDocDeMiGestoria();
    }

    match /contadoresRecibos/{contadorId} {
      allow read:  if isStaff() && resource.data.gestoriaId == miPerfil().gestoriaId;
      allow write: if isStaff() && request.resource.data.gestoriaId == miPerfil().gestoriaId;
    }

    match /cierresMensuales/{cierreId} {
      allow read:   if isStaff() && docDeMiGestoria();
      allow create: if isAdmin() && nuevaDocDeMiGestoria();
    }

    match /portalAccesos/{uid} {
      allow read:  if usuarioAutenticado() && request.auth.uid == uid;
      allow read:  if isAdmin() && docDeMiGestoria();
      allow write: if isAdmin() && docDeMiGestoria();
    }

    // ─── NUEVAS ENTIDADES SaaS+IA ────────────────────────────────────────────
    match /leads/{leadId} {
      allow read:   if isStaff() && docDeMiGestoria();
      allow create: if isStaff() && nuevaDocDeMiGestoria();
      allow update: if isStaff() && docDeMiGestoria();
      allow delete: if isAdmin() && docDeMiGestoria();
    }

    match /automatizaciones/{autoId} {
      allow read:   if isStaff() && docDeMiGestoria();
      allow create: if isAdmin() && nuevaDocDeMiGestoria();
      allow update: if isAdmin() && docDeMiGestoria();
      allow delete: if isAdmin() && docDeMiGestoria();
    }

    match /eventos/{eventoId} {
      allow read:   if isStaff() && docDeMiGestoria();
      allow create: if isStaff() && nuevaDocDeMiGestoria();
    }

    match /presupuestos/{presId} {
      allow read:   if isStaff() && docDeMiGestoria();
      allow create: if isStaff() && nuevaDocDeMiGestoria();
      allow update: if isStaff() && docDeMiGestoria();
      allow delete: if isAdmin() && docDeMiGestoria();
    }
  }
}