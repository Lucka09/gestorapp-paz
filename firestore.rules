rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // ── USERS ──────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isAuth();
    }

    // ── GESTORÍAS ──────────────────────────────────────────────────────────
    match /gestionarias/{gestoriaId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ── CLIENTES ───────────────────────────────────────────────────────────
    match /clientes/{clienteId} {
      allow read, write: if isAuth();
    }

    // ── VEHÍCULOS ──────────────────────────────────────────────────────────
    match /vehiculos/{vehiculoId} {
      allow read, write: if isAuth();
    }

    // ── TRÁMITES ───────────────────────────────────────────────────────────
    match /tramites/{tramiteId} {
      allow read, write: if isAuth();
    }

    // ── TURNOS ─────────────────────────────────────────────────────────────
    match /turnos/{turnoId} {
      allow read, write: if isAuth();
    }

    // ── NOTIFICACIONES ─────────────────────────────────────────────────────
    match /notificaciones/{notifId} {
      allow read, write: if isAuth();
    }

    // ── WHATSAPP ───────────────────────────────────────────────────────────
    match /conversacionesWA/{convId} {
      allow read, write: if isAuth();
      match /mensajes/{mensajeId} {
        allow read, write: if isAuth();
      }
    }

    // ── TAREAS ─────────────────────────────────────────────────────────────
    match /tareas/{tareaId} {
      allow read, write: if isAuth();
    }

    // ── ALERTAS ────────────────────────────────────────────────────────────
    match /alertas/{alertaId} {
      allow read, write: if isAuth();
    }
    match /alertas_sistema/{alertaId} {
      allow read, write: if isAuth();
    }

    // ── PIPELINE ───────────────────────────────────────────────────────────
    match /pipeline/{leadId} {
      allow read, write: if isAuth();
    }
    match /prospectos/{prospectoId} {
      allow read, write: if isAuth();
    }

    // ── NOTAS ──────────────────────────────────────────────────────────────
    match /notas/{notaId} {
      allow read, write: if isAuth();
    }

    // ── SEGUIMIENTOS ───────────────────────────────────────────────────────
    match /seguimientos/{seguimientoId} {
      allow read, write: if isAuth();
    }

    // ── ACTIVIDAD ──────────────────────────────────────────────────────────
    match /actividad/{actividadId} {
      allow read, create: if isAuth();
      allow update, delete: if false;
    }

    // ── VENCIMIENTOS ───────────────────────────────────────────────────────
    match /vencimientos/{vencimientoId} {
      allow read, write: if isAuth();
    }

    // ── WORKFLOWS ──────────────────────────────────────────────────────────
    match /inscripcionWorkflow/{tramiteId} {
      allow read, write: if isAuth();
    }
    match /multaWorkflow/{tramiteId} {
      allow read, write: if isAuth();
    }
    match /transferenciaWorkflow/{tramiteId} {
      allow read, write: if isAuth();
    }

    // ── AUDIT LOG ──────────────────────────────────────────────────────────
    match /audit_log/{logId} {
      allow read, create: if isAuth();
      allow update, delete: if false;
    }

    // ── ACCESO PORTAL ──────────────────────────────────────────────────────
    match /acceso/{accesoId} {
      allow read, write: if isAuth();
    }

    // ── CONFIGURACIÓN ──────────────────────────────────────────────────────
    match /configuracion/{configId} {
      allow read, write: if isAuth();
    }

    // ── PLAN LÍMITES ───────────────────────────────────────────────────────
    match /planlimits/{planId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ── CAMPAÑAS ───────────────────────────────────────────────────────────
    match /gestoriaData/{gestoriaId}/campanas/{campanaId} {
      allow read, write: if isAuth();
      match /envios/{envioId} {
        allow read, write: if isAuth();
      }
    }
    // ── Contadores de trámites (numeración correlativa) ──────────────────────────
// Solo lectura/escritura para miembros autenticados de la misma gestoría.
// El ID del documento tiene el formato: {gestoriaId}_{PREFIJO}_{YYYY}
match /contadoresTramites/{counterId} {
  allow read, write: if
    request.auth != null &&
    request.auth.token.gestoriaId != null;
}
 
// ── Cierres mensuales (M6) ───────────────────────────────────────────────────
// Solo propietario y admin_gral pueden crear cierres.
// Todos los miembros autenticados pueden leer.
match /cierresMensuales/{cierreId} {
  allow read: if
    request.auth != null &&
    request.auth.token.gestoriaId != null;
 
  allow create: if
    request.auth != null &&
    request.auth.token.gestoriaId != null &&
    (request.auth.token.rol == 'propietario' ||
     request.auth.token.rol == 'admin_gral'  ||
     request.auth.token.rol == 'superadmin');
 
  allow update, delete: if false;  // los cierres son inmutables
}

  }
}
