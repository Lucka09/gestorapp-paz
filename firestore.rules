rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAuth() { return request.auth != null; }
    function isSuperAdmin() {
      return isAuth() && userDoc().rol == 'superadmin';
    }
    function mismaGestoria(gestoriaId) {
      return isAuth() && userDoc().gestoriaId == gestoriaId;
    }
    function docDeMiGestoria() {
      return isAuth() && resource.data.gestoriaId == userDoc().gestoriaId;
    }
    function nuevaDocDeMiGestoria() {
      return isAuth() && request.resource.data.gestoriaId == userDoc().gestoriaId;
    }
    function isStaff() {
      return isAuth() &&
        userDoc().rol in ['propietario','admin','vendedor','operador'] &&
        userDoc().gestoriaId != null;
    }
    function isGestor() {
      return isAuth() && userDoc().rol == 'gestor' && userDoc().gestoriaId != null;
    }
    function tramiteEsPropio() {
      return resource.data.asignadoA == request.auth.uid || resource.data.creadoPor == request.auth.uid;
    }
    function tareaEsPropia() {
      return resource.data.asignadoA == request.auth.uid || resource.data.creadoPor == request.auth.uid;
    }
    function isOwnerOrAdmin() {
      return isAuth() && userDoc().rol in ['propietario','admin'];
    }
    function isVendedorOrAbove() {
      return isAuth() && userDoc().rol in ['propietario','admin','vendedor'];
    }
    function notChanging(fields) {
      return !(request.resource.data.diff(resource.data).affectedKeys().hasAny(fields));
    }
    function noFinancialFields() {
      return !('honorarios' in request.resource.data) &&
             !('pagado' in request.resource.data);
    }

    match /gestionarias/{gestoriaId} {
      allow read:   if isSuperAdmin() || mismaGestoria(gestoriaId);
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || (mismaGestoria(gestoriaId) && isOwnerOrAdmin());
      allow delete: if isSuperAdmin();
    }

    match /users/{uid} {
      allow read: if isSuperAdmin() || request.auth.uid == uid ||
        (isAuth() && isOwnerOrAdmin() && resource.data.gestoriaId == userDoc().gestoriaId);
      allow create: if isSuperAdmin() ||
        (isOwnerOrAdmin() && request.resource.data.gestoriaId == userDoc().gestoriaId) ||
        request.auth.uid == uid;
      allow update: if isSuperAdmin() ||
        (isOwnerOrAdmin() && resource.data.gestoriaId == userDoc().gestoriaId) ||
        (request.auth.uid == uid && notChanging(['rol','gestoriaId','activo']));
      allow delete: if isSuperAdmin();
    }

    match /clientes/{clienteId} {
      allow read: if isSuperAdmin() || (isStaff() && docDeMiGestoria()) ||
        (isAuth() && userDoc().rol == 'cliente' &&
         resource.data.clienteId == userDoc().clienteId && docDeMiGestoria());
      allow create: if isSuperAdmin() || (isStaff() && nuevaDocDeMiGestoria());
      allow update: if isSuperAdmin() ||
        (isOwnerOrAdmin() && docDeMiGestoria()) ||
        (isStaff() && docDeMiGestoria() && notChanging(['userId','gestoriaId']));
      allow delete: if isSuperAdmin() || (isOwnerOrAdmin() && docDeMiGestoria());
      match /seguimientos/{id} {
        allow read, write: if isSuperAdmin() || (isVendedorOrAbove() && docDeMiGestoria());
      }
      match /config/{id} {
        allow read, write: if isSuperAdmin() || (isVendedorOrAbove() && docDeMiGestoria());
      }
    }

    match /vehiculos/{vehiculoId} {
      allow read: if isSuperAdmin() || (isStaff() && docDeMiGestoria()) ||
        (isAuth() && userDoc().rol == 'cliente' &&
         resource.data.clienteId == userDoc().clienteId && docDeMiGestoria());
      allow create, update: if isSuperAdmin() || (isStaff() && nuevaDocDeMiGestoria());
      allow delete: if isSuperAdmin() || (isOwnerOrAdmin() && docDeMiGestoria());
    }

    match /tramites/{tramiteId} {
      allow read: if isSuperAdmin() || (isStaff() && docDeMiGestoria()) ||
        (isGestor() && docDeMiGestoria() && tramiteEsPropio()) ||
        (isAuth() && userDoc().rol == 'cliente' &&
         resource.data.clienteId == userDoc().clienteId && docDeMiGestoria()) ||
        resource.data.tokenPublico != null;
      allow create: if isSuperAdmin() || (isStaff() && nuevaDocDeMiGestoria());
      allow update: if isSuperAdmin() ||
        (isOwnerOrAdmin() && docDeMiGestoria()) ||
        (isAuth() && userDoc().rol == 'operador' && docDeMiGestoria() && noFinancialFields()) ||
        (isGestor() && docDeMiGestoria() && tramiteEsPropio() && noFinancialFields());
      allow delete: if isSuperAdmin() || (isOwnerOrAdmin() && docDeMiGestoria());
    }

    match /turnos/{turnoId} {
      allow read: if isSuperAdmin() || (isStaff() && docDeMiGestoria()) ||
        (isAuth() && userDoc().rol == 'cliente' &&
         resource.data.clienteId == userDoc().clienteId && docDeMiGestoria());
      allow create: if isSuperAdmin() || (isStaff() && nuevaDocDeMiGestoria()) ||
        (isAuth() && userDoc().rol == 'cliente' &&
         request.resource.data.clienteId == userDoc().clienteId && nuevaDocDeMiGestoria());
      allow update: if isSuperAdmin() || (isStaff() && docDeMiGestoria()) ||
        (isAuth() && userDoc().rol == 'cliente' && docDeMiGestoria() &&
         resource.data.clienteId == userDoc().clienteId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','actualizadoEn']) &&
         request.resource.data.estado == 'cancelado');
      allow delete: if isSuperAdmin() || (isStaff() && docDeMiGestoria());
    }

    match /notificaciones/{notifId} {
      allow read: if isSuperAdmin() ||
        (isAuth() && resource.data.destinatarioId == request.auth.uid && docDeMiGestoria());
      allow create: if isSuperAdmin() || (isStaff() && nuevaDocDeMiGestoria());
      allow update: if isSuperAdmin() ||
        (isAuth() && resource.data.destinatarioId == request.auth.uid && docDeMiGestoria() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida','leidaEn']));
      allow delete: if isSuperAdmin() ||
        (isOwnerOrAdmin() && docDeMiGestoria()) ||
        (isAuth() && resource.data.destinatarioId == request.auth.uid && docDeMiGestoria());
    }

    match /prospectos/{prospectoId} {
      allow read, create, update: if isSuperAdmin() || (isVendedorOrAbove() && docDeMiGestoria());
      allow delete: if isSuperAdmin() || (isOwnerOrAdmin() && docDeMiGestoria());
    }

    match /configuracion/{configId} {
      allow read:  if isSuperAdmin() || (isStaff() && mismaGestoria(configId));
      allow write: if isSuperAdmin() || (isOwnerOrAdmin() && mismaGestoria(configId));
    }

    match /notas_internas/{notaId} {
      allow read: if isSuperAdmin() || (isStaff() && docDeMiGestoria());
      allow create: if isSuperAdmin() || (isStaff() && nuevaDocDeMiGestoria());
      allow update, delete: if isSuperAdmin() ||
        (isAuth() && resource.data.autorId == request.auth.uid && docDeMiGestoria()) ||
        (isOwnerOrAdmin() && docDeMiGestoria());
    }

    match /tareas/{tareaId} {
      allow read: if isSuperAdmin() || (isStaff() && docDeMiGestoria()) ||
        (isGestor() && docDeMiGestoria() && tareaEsPropia());
      allow create: if isSuperAdmin() || (isStaff() && nuevaDocDeMiGestoria()) ||
        (isGestor() && nuevaDocDeMiGestoria());
      allow update, delete: if isSuperAdmin() || (isStaff() && docDeMiGestoria()) ||
        (isGestor() && docDeMiGestoria() && tareaEsPropia());
    }

    match /vencimientos/{vencimientoId} {
      allow read, create, update: if isSuperAdmin() || (isStaff() && docDeMiGestoria());
      allow delete: if isSuperAdmin() || (isOwnerOrAdmin() && docDeMiGestoria());
    }

    match /alertas_sistema/{alertaId} {
      allow read: if isSuperAdmin() || (isStaff() && docDeMiGestoria());
      allow write: if isSuperAdmin() || (isStaff() && nuevaDocDeMiGestoria());
    }

    match /audit_log/{entradaId} {
      allow read: if isSuperAdmin() || (isOwnerOrAdmin() && docDeMiGestoria());
      allow create: if isSuperAdmin() || isStaff() || isGestor();
      allow update, delete: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
