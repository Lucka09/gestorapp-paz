rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Archivos de workflows (fotos de trámites)
    match /gestoria-paz/workflows/{tramiteId}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024  // máx 10MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Fotos de perfil del equipo
    match /gestoria-paz/equipo/{uid}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Documentos PDF de trámites
    match /gestoria-paz/documentos/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024;
    }

    // Multitenant — otras gestorías futuras
    match /{gestoriaId}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024;
    }

  }
}
