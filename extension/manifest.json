{
  "manifest_version": 3,
  "name": "GestorApp — Consulta de Infracciones PBA y CABA",
  "version": "0.1.3",
  "description": "Captura las actas de los portales de infracciones de PBA y CABA y las envía a GestorApp.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://infraccionesba.gba.gob.ar/*",
    "https://buenosaires.gob.ar/licenciasdeconducir/*",
    "https://buenosaires.gob.ar/comprobante-de-legajo/*",
    "https://panel.gestoriapaz.com/*",
    "https://gestorapp-tau.vercel.app/*",
    "https://gestorapp-paz.web.app/*",
    "https://colaproximaconsulta-jgbhipicma-uc.a.run.app/*",
    "https://guardarconsultainfraccion-jgbhipicma-uc.a.run.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://infraccionesba.gba.gob.ar/*",
        "https://buenosaires.gob.ar/licenciasdeconducir/*",
        "https://buenosaires.gob.ar/comprobante-de-legajo/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://panel.gestoriapaz.com/*",
        "https://gestorapp-tau.vercel.app/*",
        "https://gestorapp-paz.web.app/*",
        "http://localhost:5173/*",
        "http://localhost:5174/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["interceptor.js"],
      "matches": ["https://infraccionesba.gba.gob.ar/*"]
    }
  ]
}